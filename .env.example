# Names only are sufficient for normal use. Never commit the populated .env file.
FABRIC_WORKSPACE_NAME=fabric-onelake-catalog-governance-poc
FABRIC_CAPACITY_NAME=<active-capacity-name>
FABRIC_DOMAIN_NAME=<approved-business-domain>

# Optional OneLake role inputs. Treat environment identifiers as private inventory.
FABRIC_TENANT_ID=<tenant-id>
FABRIC_PUBLIC_READER_GROUP_ID=<security-group-object-id>
FABRIC_US_RESTRICTED_READER_GROUP_ID=<security-group-object-id>

# Authentication is passwordless through Azure CLI, managed identity, workload identity,
# Visual Studio Code, or another DefaultAzureCredential provider. Do not add secrets here.
